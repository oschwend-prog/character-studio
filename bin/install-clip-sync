#!/usr/bin/env bash
# Owner helper: install (or remove) the LaunchAgent that takes the clips in the iCloud folder "ODD EYES clips" and in the
# repo's inbox/drops as drops, every 5 minutes (`bin/studio drop sync-folder`, once per folder). Nothing secret is written: the agent runs bin/studio,
# which reads the Keychain itself.
#   bin/install-clip-sync              create the folder, write the agent, load it, show the log
#   bin/install-clip-sync --uninstall  stop and remove the agent (the folder and the ledger stay)
set -euo pipefail

label="com.oddeyes.clip-sync"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
icloud="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
folder="$icloud/ODD EYES clips"
inbox="$root/inbox/drops"   # the owner's second clips folder, on this Mac only (git-ignored); the same ledger, so a clip in both is one drop
plist="$HOME/Library/LaunchAgents/$label.plist"
log="$HOME/Library/Logs/odd-eyes-clip-sync.log"
domain="gui/$(id -u)"

run_wait="${CLIP_SYNC_WAIT:-60}"   # seconds a run in progress may take to finish before the agent is stopped

usage() { echo "Usage: bin/install-clip-sync [--uninstall]"; }
xml() { printf %s "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
loaded() { launchctl print "$domain/$label" >/dev/null 2>&1; }
job_pid() { { launchctl list "$label" 2>/dev/null || true; } | sed -n 's/^[[:space:]]*"PID" = \([0-9][0-9]*\);$/\1/p'; }

# Let a sync that is running finish before the agent is stopped: bootout kills it, and a run killed in the middle of an
# upload would leave half a drop behind (the next run mends that, but waiting is cheaper). Bounded: a run blocked on a
# macOS dialog never ends, so after $run_wait seconds the agent is stopped anyway and the script says so.
wait_for_run() {
  local pid waited=0
  pid="$(job_pid)"
  [ -n "$pid" ] || return 0
  echo "A sync is running (pid $pid): waiting up to ${run_wait} s for it to finish before stopping the agent..."
  while [ "$waited" -lt "$run_wait" ]; do
    sleep 1
    waited=$((waited + 1))
    if [ -z "$(job_pid)" ]; then echo "It finished after ${waited} s."; return 0; fi
  done
  echo "It is still running after ${run_wait} s (a run waiting for an answer to a macOS dialog never ends): stopping it anyway."
  echo "If it was in the middle of a clip, the next run finishes it (the drop is already tagged with the clip's hash)."
}

# bootout, then wait (up to 10 s) until launchd really has let go of the job: bootstrap straight after bootout can fail.
bootout() {
  local i
  launchctl bootout "$domain/$label" 2>/dev/null || true
  for i in $(seq 1 20); do
    loaded || return 0
    sleep 0.5
  done
  echo "Note: launchd still lists $label 10 s after bootout; going on."
}

# bootstrap, up to 3 tries 2 s apart (after a bootout it sometimes answers "5: Input/output error" for a moment).
bootstrap() {
  local try err=""
  for try in 1 2 3; do
    if err="$(launchctl bootstrap "$domain" "$plist" 2>&1)"; then return 0; fi
    [ "$try" = 3 ] || { bootout; sleep 2; }
  done
  echo "launchctl could not load the agent after 3 tries: ${err:-no message}" >&2
  echo "The agent file is written ($plist) but nothing is loaded. Run bin/install-clip-sync again," >&2
  echo "or: launchctl bootstrap $domain \"$plist\"" >&2
  exit 1
}

uninstall=0
case "${1:-}" in
  "") ;;
  --uninstall) uninstall=1 ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

if [ "$uninstall" = 1 ]; then
  wait_for_run
  bootout
  rm -f "$plist"
  echo "Removed the clips sync agent ($label). The folder and the ledger are untouched:"
  echo "  $folder"
  exit 0
fi

# iCloud Drive must be on: the folder lives in it.
if [ ! -d "$icloud" ]; then
  echo "iCloud Drive is off on this Mac ($icloud is missing)."
  echo "Turn it on in System Settings > Apple Account > iCloud > Drive, then run bin/install-clip-sync again."
  exit 1
fi

# Where uv and gh are: launchd's own PATH has neither /opt/homebrew/bin nor necessarily /usr/local/bin.
agent_path="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
for tool in uv gh; do
  found="$(command -v "$tool" || true)"
  if [ -z "$found" ]; then
    if [ "$tool" = uv ]; then echo "uv is not installed (command -v uv finds nothing): install it first."; exit 1; fi
    echo "Note: gh is not installed, so the cloud check is not woken after a clip is added (the daily run still checks it)."
    continue
  fi
  dir="$(dirname "$found")"
  case ":$agent_path:" in *":$dir:"*) ;; *) agent_path="$agent_path:$dir" ;; esac
done
uv_real="$(realpath "$(command -v uv)")"

mkdir -p "$folder/Added" "$inbox/Added" "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"

wait_for_run

# Write the agent next to its final place, check it, then move it over the old one.
tmp="$(mktemp "$plist.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
cat > "$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>"\$0" drop sync-folder; "\$0" drop sync-folder --folder "\$1"</string>
    <string>$(xml "$root/bin/studio")</string>
    <string>$(xml "$inbox")</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>$(xml "$agent_path")</string>
  </dict>
  <key>StandardOutPath</key><string>$(xml "$log")</string>
  <key>StandardErrorPath</key><string>$(xml "$log")</string>
</dict></plist>
EOF
plutil -lint "$tmp" >/dev/null
chmod 644 "$tmp"
mv "$tmp" "$plist"
trap - EXIT

# Load it (bootout first: a reinstall replaces the running one). RunAtLoad starts the first run by itself; the plain kickstart
# (no -k: it never kills a run) only makes sure one is started. Then look at the log.
before=0
[ -f "$log" ] && before="$(wc -l < "$log")"
bootout
launchctl enable "$domain/$label" 2>/dev/null || true
bootstrap
launchctl kickstart "$domain/$label" 2>/dev/null || true
echo "Loaded $label (every 5 minutes). Waiting 10 s for the first run..."
sleep 10

new="$(tail -n +"$((before + 1))" "$log" 2>/dev/null || true)"
running=0
launchctl list | awk -v l="$label" '$3 == l && $1 != "-" { found = 1 } END { exit !found }' && running=1
echo "--- $log (this run) ---"
if [ -n "$new" ]; then printf '%s\n' "$new" | tail -n 20; else echo "(nothing written yet)"; fi
echo "-----"

if printf '%s\n' "$new" | grep -q "Operation not permitted"; then
  echo "macOS is refusing the background job access to iCloud Drive. Allow it once:"
  echo "  System Settings > Privacy & Security > Full Disk Access > + : add the uv binary"
  echo "  ($uv_real) and /bin/bash"
  echo "  (in the file picker press Cmd+Shift+G to type a path; hidden folders such as ~/.local need it)."
  echo "Then run bin/install-clip-sync again. Meanwhile the daily run still syncs the folder."
  exit 1
fi
if [ -z "$new" ] && [ "$running" = 1 ]; then
  # A first run that is still going after 10 s with an empty log is a slow start or macOS waiting for an answer.
  echo "The first run is still going and has written nothing yet. Either it is a slow start, or macOS is waiting for"
  echo "your answer to a permission dialog about iCloud Drive (it may name uv or python): click Allow. Then check the log:"
  echo "  tail \"$log\""
  echo "If it says Operation not permitted, the answer was no: grant Full Disk Access to $uv_real"
  echo "(System Settings > Privacy & Security), then run bin/install-clip-sync again. Meanwhile the daily run still syncs the folder."
  exit 0
fi
echo "Folder: $folder"
echo "Log:    tail -f \"$log\""
echo "Remove: bin/install-clip-sync --uninstall"
