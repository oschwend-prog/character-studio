#!/usr/bin/env bash
# Owner helper: store the two Supabase secrets in the macOS Keychain, checking their shape first.
# Input is hidden; nothing is written to a file or printed. Run: bin/store-secrets
set -euo pipefail

store() { security add-generic-password -U -s "$1" -a "$USER" -w "$2"; }

if [ "${1:-}" = "--db-password-from-clipboard" ]; then
  # Read the password Supabase generated straight from the clipboard: no terminal paste, no autofill.
  pw="$(pbpaste | tr -d '\r\n')"
  if [ -z "$pw" ] || [ "${#pw}" -lt 12 ] || printf %s "$pw" | grep -q '[[:space:]]'; then
    echo "The clipboard doesn't hold a password (empty, too short or has spaces). Copy it again with Supabase's copy icon."; exit 1
  fi
  enc="$(PW="$pw" python3 -c 'import os,urllib.parse;print(urllib.parse.quote(os.environ["PW"],safe=""))')"
  store cs-database-url "postgresql://postgres.hkcafvzjwkeibbmvskko:${enc}@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
  echo "Saved a ${#pw}-character password from the clipboard into the Keychain."
  unset pw enc; printf '' | pbcopy
  echo "Clipboard cleared. Tell Claude to re-run the go-live check."
  exit 0
fi
if [ "${1:-}" = "--new-db-password" ]; then
  # Make the password here, so nothing is copied out of a dialog by hand.
  pw="$(python3 -c 'import secrets,string;print("".join(secrets.choice(string.ascii_letters+string.digits) for _ in range(24)))')"
  store cs-database-url "postgresql://postgres.hkcafvzjwkeibbmvskko:${pw}@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
  printf %s "$pw" | pbcopy; unset pw
  echo "A new database password is stored in the Keychain and is on your clipboard."
  echo "Now in Supabase > Database > Settings > Reset password:"
  echo "  paste it into the password field with Cmd+V (do NOT click 'Generate a password'), then click Reset password."
  read -r -p "Press Enter here once Supabase says the password was reset... " _
  printf '' | pbcopy
  echo "Clipboard cleared. Tell Claude to re-run the go-live check."
  exit 0
fi

echo "1/2 Database password (the one you set for the faceless-youtube project;"
echo "    forgotten it? Supabase > Connect > Session pooler > 'Reset database password')."
read -r -s -p "    Paste the password (hidden; Enter = keep the stored one): " pw; echo
if [ -z "$pw" ]; then echo "    kept."; else
enc="$(PW="$pw" python3 -c 'import os,urllib.parse;print(urllib.parse.quote(os.environ["PW"],safe=""))')"
store cs-database-url "postgresql://postgres.hkcafvzjwkeibbmvskko:${enc}@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"
echo "    saved (session pooler, aws-0-eu-west-2, port 5432)."
fi
unset pw enc

echo "2/2 Service key: Supabase > Project Settings > API Keys > tab 'Legacy API keys' > service_role > Reveal > copy"
echo "    (it starts with eyJ; the new sb_secret_ keys don't work with our Bearer header yet)."
while :; do
  read -r -s -p "    Paste it (hidden; Enter = keep the stored one): " key; echo
  key="$(printf %s "$key" | tr -d '[:space:]')"
  if [ -z "$key" ]; then echo "    kept."; break; fi
  case "$key" in
    sb_publishable_*) echo "    That is the publishable (public) key: copy the secret / service_role one." ;;
    sb_secret_*) echo "    That is a new-style secret key: use the legacy service_role key (starts with eyJ)." ;;
    eyJ*.*.*)
      if [ "${#key}" -ge 40 ]; then store cs-supabase-service-key "$key"; echo "    saved."; break
      else echo "    Too short to be a key: copy the whole value."; fi ;;
    *) echo "    Not the service_role key (it starts with eyJ). Try again." ;;
  esac
done
unset key
echo "Done. Tell Claude to re-run the go-live check."
